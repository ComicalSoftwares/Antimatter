<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.comicalsoftwares.antimatter</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Antimatter Lite</name>
  <summary>Code in Python. Not in Bloat.</summary>
  <description>
    <p>
        Antimatter is a Python IDE designed to run smoothly on as many devices as possible without having the bloat other big/popular IDEs tend to have.
        This is the light version of the OG project, it can only edit/run python/markdown files to be flathub-compilant.
        This IDE features the following functions:
    </p>
        <ul>
          <li>A Distraction-free interface. No popups, everything is on-demand</li>
          <li>Editing Python/Markdown Files</li>
          <li>Full Discord Rich Presence Support</li>
          <li>Automatic .venv environments setup</li>
          <li>Actually Good performance</li>
          <li>A sleek, PyQT6 Interface built from the ground up to beautifully integrate with the KDE Plasme environment</li>
          <li>Quickly find the bugs that stop you from running your .py scripts (Powered by PyFlakes)</li>
        </ul>
  </description>

  <developer id="io.github.comicalsoftwares">
    <name>Comical</name>
  </developer>

