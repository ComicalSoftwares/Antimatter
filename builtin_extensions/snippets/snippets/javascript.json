{
  "For loop": {
    "prefix": "for",
    "body": [
      "for (let ${1:i} = 0; ${1:i} < ${2:n}; ${1:i}++) {",
      "    $0",
      "}"
    ]
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "function ${1:name}(${2:args}) {",
      "    $0",
      "}"
    ]
  },
  "Arrow": {
    "prefix": "af",
    "body": "const ${1:name} = (${2:args}) => {$0};"
  },
  "Console log": {
    "prefix": "cl",
    "body": "console.log($0);"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "    $0",
      "}"
    ]
  }
}