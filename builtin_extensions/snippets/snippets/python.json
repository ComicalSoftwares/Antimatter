{
  "For loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items}:",
      "    $0"
    ]
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition}:",
      "    $0"
    ]
  },
  "If else": {
    "prefix": "ife",
    "body": [
      "if ${1:condition}:",
      "    ${2:pass}",
      "else:",
      "    $0"
    ]
  },
  "Function": {
    "prefix": "def",
    "body": [
      "def ${1:name}(${2:args}):",
      "    $0"
    ]
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name}:",
      "    def __init__(self${2:, args}):",
      "        $0"
    ]
  },
  "Main guard": {
    "prefix": "main",
    "body": [
      "def main():",
      "    $0",
      "",
      "",
      "if __name__ == \"__main__\":",
      "    main()"
    ]
  },
  "Try except": {
    "prefix": "try",
    "body": [
      "try:",
      "    $1",
      "except ${2:Exception} as e:",
      "    $0"
    ]
  },
  "With open": {
    "prefix": "with",
    "body": [
      "with open(${1:path}, ${2:\"r\"}, encoding=\"utf-8\") as f:",
      "    $0"
    ]
  },
  "Print": {
    "prefix": "pr",
    "body": "print($0)"
  },
  "List comprehension": {
    "prefix": "lc",
    "body": "[${1:x} for ${2:x} in ${3:items}]$0"
  }
}