{
    "id": "io.github.comicalsoftwares.antimatter",

    "runtime": "org.kde.Platform",

    "runtime-version": "6.7",

    "sdk": "org.kde.Sdk",

    "base": "com.riverbankcomputing.PyQt.BaseApp",

    "base-version": "6.11",

    "command": "antimatter",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri"
    ],
    "modules": [
        "python3-deps.json",
        {
            "name": "antimatter",
            "buildsystem" : "simple",
            "build-commands" : [
                "mkdir -p /app/lib/antimatter /app/bin",
                "cp *.py /app/lib/antimatter/",
                "install -Dm755 antimatter-wrapper /app/bin/antimatter"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/ComicalSoftwares/Antimatter.git",
                    "commit": "5427af5c61aab1d3ffd033651602bbfed6cc6273"
                }
            ]
        }
    ]
}
