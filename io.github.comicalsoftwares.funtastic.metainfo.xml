<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.comicalsoftwares.antimatter</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Funtastic</name>
  <summary>A blazing fast Python IDE</summary>
  <description>
    <p>
        Antimatter is a Python IDE designed to run smoothly on any hardware without the bloat of the other big/popular IDEs.
    </p>
</description>

  <developer id="io.github.comicalsoftwares">
    <name>Comical</name>
  </developer>

  <!-- Required: Should be a link to the upstream homepage for the component -->
  <url type="homepage">https://antimatter.codelyteam.com</url>
  <!-- Recommended: It is highly recommended for open-source projects to display the source code repository -->
  <url type="vcs-browser">https://github.com/ComicalSoftwares/Antimatter</url>
  <!-- Should point to the software's bug tracking system, for users to report new bugs -->
  <url type="bugtracker">https://github.com/ComicalSoftwares/Antimatter/issues</url>

  <!-- Disabled the next lines because for the moment I do not have the corresponding resources for them -->

  <!-- Should link a FAQ page for this software, to answer some of the most-asked questions in detail -->
