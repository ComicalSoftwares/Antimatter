{
    "id": "io.github.comicalsoftwares.antimatter",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "base": "com.riverbankcomputing.PyQt.BaseApp",
    "base-version": "6.11",
    "command": "antimatter",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=xdg-run/discord-ipc-0",
        "--filesystem=xdg-run/app/com.discordapp.Discord:create"
    ],
    "modules": [
        "python3-deps.json",
        {
            "name": "antimatter",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/lib/antimatter /app/bin /app/share/applications /app/share/metainfo /app/share/icons/hicolor/512x512/apps",
                "cp src/*.py src/AppIcon.png src/about.txt /app/lib/antimatter/",
                "install -Dm755 wrapper /app/bin/antimatter",
                "install -Dm644 Flatpak/io.github.comicalsoftwares.antimatter.desktop /app/share/applications/io.github.comicalsoftwares.antimatter.desktop",
                "install -Dm644 Flatpak/io.github.comicalsoftwares.antimatter.metainfo.xml /app/share/metainfo/io.github.comicalsoftwares.antimatter.metainfo.xml",
                "install -Dm644 src/AppIcon.png /app/share/icons/hicolor/512x512/apps/io.github.comicalsoftwares.antimatter.png"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/ComicalSoftwares/Antimatter.git",
                    "tag": "1.7-Patch1",
                    "commit": "9549d0e32e6c9e9ebf92b0bfafb7ba569aed0986"
                }
            ]
        }
    ]
}
